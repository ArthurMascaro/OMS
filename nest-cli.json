{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/core/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/core/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/core",
  "projects": {
    "core": {
      "type": "application",
      "root": "apps/core",
      "entryFile": "main",
      "sourceRoot": "apps/core/src",
      "compilerOptions": {
        "tsConfigPath": "apps/core/tsconfig.app.json"
      }
    },
    "plugin-marketplace-b": {
      "type": "application",
      "root": "apps/plugin-marketplace-b",
      "entryFile": "main",
      "sourceRoot": "apps/plugin-marketplace-b/src",
      "compilerOptions": {
        "tsConfigPath": "apps/plugin-marketplace-b/tsconfig.app.json"
      }
    },
    "plugin-mercado-livre": {
      "type": "application",
      "root": "apps/plugin-mercado-livre",
      "entryFile": "main",
      "sourceRoot": "apps/plugin-mercado-livre/src",
      "compilerOptions": {
        "tsConfigPath": "apps/plugin-mercado-livre/tsconfig.app.json"
      }
    }
  }
}
